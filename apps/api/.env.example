# Backend configuration. Copy to `.env` (git-ignored). NEVER commit real values.
# Every variable here is backend-only. The frontend has its own public-only env (apps/web/.env.example).

APP_ENV=local                      # local | test | staging | production

# Postgres (local docker compose default shown; Supabase: use the "connection string" from the dashboard)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Comma-separated explicit browser origins (never *)
CORS_ORIGINS=http://localhost:5173

# Supabase Auth JWT verification: set ONE of these
SUPABASE_JWKS_URL=                 # e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=               # HS256 secret (local Supabase CLI / legacy projects)
JWT_AUDIENCE=authenticated
JWT_ISSUER=

# Supabase project (backend-only; the service-role key must NEVER reach the browser)
SUPABASE_URL=                      # e.g. https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Re-authentication window for sensitive changes (docs/adr/0004)
REAUTH_MAX_AGE_SECONDS=300

# Private QR storage: 'local' for development only; 'supabase' in staging/production
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local-storage
QR_BUCKET=qr

# Payment-token crypto (docs/adr/0001). Generate:
#   TOKEN_ENC_KEY:     python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
#   TOKEN_HMAC_SECRET: python -c "import secrets;print(secrets.token_hex(32))"
TOKEN_ENC_KEY=
TOKEN_ENC_KEY_ID=k1
TOKEN_HMAC_SECRET=

# Scanned-PDF text recognition (Tesseract is installed in the Docker image; locally: brew install tesseract).
# Runs inside the request with hard limits. Set OCR_ENABLED=false to turn scanned PDFs off.
OCR_ENABLED=true
OCR_LANGUAGES=eng
PDF_MAX_PAGES=10
PDF_TIMEOUT_SECONDS=60

# Google Sheets import. Public ("anyone with the link") sheets need NOTHING here.
# Private sheets: create a Google Cloud service account, enable the Google Sheets API, and share
# each sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer. Set BOTH values or NEITHER. Backend-only:
# the private key must never reach the browser or the repository.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=   # the PEM "private_key" from the JSON key; "\n" escapes are fine

# AI fallback: OFF by default, needs a key AND a monthly cost cap to enable
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MONTHLY_COST_CAP_USD=0

# Retention (frozen product defaults)
IMPORT_RETENTION_DAYS=90
FAILED_IMPORT_RETENTION_DAYS=7
