# Frontend env: PUBLIC VALUES ONLY (these are baked into the browser bundle).
# Never put any backend secret here (see apps/api/.env.example for what is backend-only).
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public base URL used when building customer payment links (hash-routed, see docs/adr/0002)
VITE_PUBLIC_APP_URL=http://localhost:5173
# '/' for a custom domain, '/<repo>/' for a GitHub project Pages site
VITE_BASE_PATH=/
